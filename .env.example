# ==========================================
# Gede Bali Guide - Environment Variables Example
# Duplicate this file to .env.local and fill in the values.
# ==========================================

# --- Firebase Client Configuration (Public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=guidebali.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=guidebali
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=guidebali.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK Configuration (Server-side Only / Secrets) ---
FIREBASE_PROJECT_ID=guidebali
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Cloudinary Media Optimization Configuration ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
