# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build output
/.next/
/out/

# Production build
/build
/dist

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env*
!.env.example

# Private certificates, keys, & service account credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*service-account*.json
*firebase-adminsdk*.json
serviceAccountKey.json
credentials.json
secrets.json

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Deployment & Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI assistant / local tool directories
.claude/
.codex/
.gemini/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
